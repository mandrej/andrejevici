{
  "name": "function-youtube",
  "description": "Cloud Functions for Firebase - YouTube caption extractor",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "build": "tsc",
    "deploy": "npm run build && firebase deploy --only functions:getYouTubeDetails",
    "logs": "firebase functions:log",
    "test": "tsx --test test/index.test.ts"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.0.1",
    "youtube-caption-extractor": "^1.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.35.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "private": true
}
